# ── Atlas Multimodal Enterprise Agent Platform ──────────────────────────────
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# ── API Keys ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_google_ai_studio_key_here          # https://aistudio.google.com/app/apikey
GROQ_API_KEY=your_groq_api_key_here                    # https://console.groq.com/keys
HF_TOKEN=your_huggingface_token_here                   # https://huggingface.co/settings/tokens

# ── Qdrant Vector Database ────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# ── LangSmith Tracing (optional but recommended) ─────────────────────────────
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=multimodal-agent-platform

# ── LLM Models ───────────────────────────────────────────────────────────────
LLM_PRIMARY_MODEL=gemini-2.0-flash                     # Primary reasoning model (Gemini)
LLM_BULK_MODEL=gemini-2.0-flash-lite                   # High-volume / cheaper tasks
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b             # Fallback via Groq when Gemini is rate-limited

# ── Embedding Model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=models/text-embedding-004              # Google text embedding model

# ── Audio / Speech Models ─────────────────────────────────────────────────────
TTS_MODEL=gemini-2.5-flash-preview-tts                 # Text-to-speech (Gemini)
STT_MODEL=whisper-large-v3-turbo                       # Speech-to-text model name
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1     # Speaker diarization (HuggingFace)
STT_PROVIDER=groq                                      # STT provider: groq | google

# ── Frontend Feature Flags ────────────────────────────────────────────────────
VITE_ENABLE_PUTER_STT=false                            # Enable Puter.js STT in the browser
VITE_PUTER_STT_MODEL=gpt-4o-mini-transcribe            # Puter STT model (only if enabled)
